rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() {
      return signed() && request.auth.token.email == 'admin@example.com'   // <- same as ADMIN_EMAIL
             && request.auth.token.email_verified == true;
    }
    function active() {
      return signed() && !get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('disabled', false);
    }
    function member(c) {
      return request.auth.uid in get(/databases/$(db)/documents/chats/$(c)).data.members;
    }
    function other(c) {
      return c.split('_')[0] == request.auth.uid ? c.split('_')[1] : c.split('_')[0];
    }

    match /usernames/{n} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.uid == request.auth.uid
                    && n.matches('^[a-z0-9_]{3,20}$');
      allow delete: if isAdmin();
    }

    match /users/{u} {
      allow read: if signed();
      allow create: if signed() && u == request.auth.uid
        && request.resource.data.get('disabled', false) == false
        && getAfter(/databases/$(db)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == u;
      allow update: if (u == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive', 'pubKey']))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled']));
      allow delete: if isAdmin();
    }

    match /userPrivate/{u} {
      allow create: if signed() && u == request.auth.uid;
      allow read: if signed() && (u == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /chats/{c} {
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow create, update: if active()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll(c.split('_'));

      match /blocks/{b} {
        allow read: if signed() && member(c);
        allow write: if signed() && b == request.auth.uid && member(c);
      }

      match /messages/{m} {
        allow read: if signed() && member(c);
        allow create: if active() && member(c)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.keys().hasOnly(['from', 'ct', 'iv', 'ts'])
          && !exists(/databases/$(db)/documents/chats/$(c)/blocks/$(request.auth.uid))
          && !exists(/databases/$(db)/documents/chats/$(c)/blocks/$(other(c)));
        allow delete: if signed() && resource.data.from == request.auth.uid;
      }
    }
  }
}
